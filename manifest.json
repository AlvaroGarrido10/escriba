{
  "manifest_version": 3,
  "name": "Escriba",
  "version": "3.3.0",
  "description": "Graba tus reuniones (Meet, Teams o presenciales), transcríbelas con IA y genera actas con Gemini, GPT o Claude.",
  "permissions": [
    "tabCapture",
    "downloads",
    "storage",
    "activeTab",
    "offscreen",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "sidePanel"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Escriba",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "side_panel": {
    "default_path": "vivo.html"
  },
  "commands": {
    "grabar": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Empezar o parar la grabación"
    },
    "marcar": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Marcar este momento de la reunión"
    }
  }
}
